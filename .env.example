# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://pansari:pansari@localhost:5432/pansari
TEST_DATABASE_URL=postgresql+psycopg://pansari:pansari@localhost:5432/pansari_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-in-every-environment
SITE_URL=http://localhost:8000
MEDIA_ROOT=media
MAX_UPLOAD_MB=5
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
